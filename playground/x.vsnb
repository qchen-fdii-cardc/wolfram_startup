  {
   "kind": 2,
   "value": "(* 3D高斯曲面，导出 surface.png *)\r\nplot = Plot3D[\r\n    Exp[-(x^2 + y^2)/0.8],\r\n    {x, -3, 3}, {y, -3, 3},\r\n    PlotTheme -> \"Scientific\",\r\n    Mesh -> 15,\r\n    MeshStyle -> Opacity[0.2],\r\n    AxesLabel -> {\"x\", \"y\", \"z\"},\r\n    ColorFunction -> \"BlueGreenYellow\"\r\n];\r\nExport[\"surface.png\", plot, ImageResolution -> 300];\r\nplot\r\n",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:384px;height:298px;\" aspect-ratio=\"0.7750\" tabIndex=\"-1\"><img class=\"invert-brightness\" src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "05ba7a15-c469-4975-bed0-fadfc1106216"
    }
   ],
   "metadata": {},
   "executionSummary": {

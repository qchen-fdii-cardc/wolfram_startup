  {
   "kind": 2,
   "value": "(* 蝴蝶曲线，导出 butterfly.png *)\r\nbutterfly[t_] := (Exp[Sin[t]] - 2 Cos[4 t] + Sin[(2 t - Pi)/24]^5) {Cos[t], Sin[t]};\r\n\r\nplot = ParametricPlot[butterfly[t], {t, 0, 12 Pi},\r\n    PlotTheme -> \"Business\",\r\n    PlotPoints -> 300,\r\n    Axes -> False,\r\n    Background -> Black,\r\n    PlotStyle -> {RGBColor[0.4, 0.9, 1], Thickness[0.002]}\r\n];\r\nExport[\"butterfly.png\", plot, ImageResolution -> 300];\r\nplot",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:384px;height:339px;\" aspect-ratio=\"0.8833\" tabIndex=\"-1\"><img class=\"invert-brightness\" src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "30546260-d9bb-4239-8c5d-591624d266dd"
    }
   ],

  {
   "kind": 2,
   "value": "plot = Plot[\r\n    {Sin[x], Cos[x], Sin[x] Cos[x]},\r\n    {x, 0, 2 Pi},\r\n    PlotLegends -> {\"Sin[x]\", \"Cos[x]\", \"Sin[x] Cos[x]\"},\r\n    PlotTheme -> \"Scientific\",\r\n    Filling -> {1 -> {2, Opacity[0.12]}},\r\n    GridLines -> Automatic,\r\n    AxesLabel -> {\"x\", \"y\"},\r\n    BaseStyle -> {FontFamily -> \"Arial\", FontSize -> 12}\r\n];\r\n\r\noutPath = FileNameJoin[{\"D:/sources/wolfram_startup/playground\" ,\"curve.png\"}];\r\nExport[outPath, plot, ImageResolution -> 300];\r\nplot",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:503px;height:238px;\" aspect-ratio=\"0.4738\" tabIndex=\"-1\"><img class=\"invert-brightness\" src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
